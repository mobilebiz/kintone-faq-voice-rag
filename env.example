# 管理CLI・評価・性能測定スクリプト用。`cp env.example .env` して使う（.env はコミットしない）。
# APIトークンやキーはコマンド引数ではなく環境変数で渡す。

# ---- kintone ----
KINTONE_BASE_URL=https://your-subdomain.cybozu.com
KINTONE_APP_ID=146
# KINTONE_GUEST_SPACE_ID=
# 管理CLI用：レコード閲覧＋編集権限のトークン。Workers には配置しない。
KINTONE_WRITE_API_TOKEN=your-kintone-read-write-token
# check:deps で Workers 用の閲覧専用トークンも確認する場合
KINTONE_READ_API_TOKEN=your-kintone-read-only-token

# ---- フィールドコード（既定値と異なる場合のみ） ----
# FIELD_CATEGORY=category
# FIELD_QUESTION=question
# FIELD_ANSWER=answer
# FIELD_EMBEDDING=embedding
# FIELD_EMBEDDING_SPEC=embedding_spec
# FIELD_EMBEDDING_HASH=embedding_hash
# FIELD_EMBEDDED_AT=embedded_at

# ---- Embedding（Workers側と完全に一致させる） ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SPEC_ID=openai/text-embedding-3-small/1536/faq-v1
EMBEDDING_API_KEY=sk-your-openai-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# 1レコードの入力上限（文字数）。超過レコードはエラー報告し、切り詰めない。
# EMBEDDING_MAX_INPUT_CHARS=6000

# ---- 検索API（評価・性能測定・疎通確認） ----
SEARCH_API_URL=https://kintone-semantic-search.your-account.workers.dev
FAQ_SEARCH_API_KEY=change-me

{
  "info": {
    "name": "kintone FAQ Search API",
    "description": "kintone FAQ 意味検索API（Cloudflare Workers）の動作確認用。baseUrl / apiKey をコレクション変数または環境で設定する。ローカルは wrangler dev（http://127.0.0.1:8787）。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8787"
    },
    {
      "key": "apiKey",
      "value": "local-dev-key"
    }
  ],
  "item": [
    {
      "name": "healthz",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/healthz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "healthz"
          ]
        }
      }
    },
    {
      "name": "検索（基本）",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Cache-Control: no-store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "const j = pm.response.json();",
              "pm.test(\"status は matched/ambiguous/no_match\", () => pm.expect([\"matched\",\"ambiguous\",\"no_match\"]).to.include(j.status));",
              "pm.test(\"meta がある\", () => { pm.expect(j.meta).to.have.keys([\"cache\",\"snapshot_at\",\"embedding_spec\",\"degraded\",\"reason\",\"timings_ms\"]); });",
              "if (j.status === \"no_match\") pm.test(\"no_match の results は空\", () => pm.expect(j.results).to.eql([]));",
              "console.log(j.status, j.meta.reason, j.meta.cache, (j.results||[]).map(r => r.id + \":\" + r.score).join(\", \"));",
              "pm.test(\"request_id を返す\", () => pm.expect(j.request_id).to.eql(\"req-example-001\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"ログインのパスワードを忘れたので再設定したい\",\n  \"limit\": 3,\n  \"request_id\": \"req-example-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/faq/search",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "faq",
            "search"
          ]
        }
      }
    },
    {
      "name": "検索（カテゴリ指定）",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Cache-Control: no-store\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "const j = pm.response.json();",
              "pm.test(\"status は matched/ambiguous/no_match\", () => pm.expect([\"matched\",\"ambiguous\",\"no_match\"]).to.include(j.status));",
              "pm.test(\"meta がある\", () => { pm.expect(j.meta).to.have.keys([\"cache\",\"snapshot_at\",\"embedding_spec\",\"degraded\",\"reason\",\"timings_ms\"]); });",
              "if (j.status === \"no_match\") pm.test(\"no_match の results は空\", () => pm.expect(j.results).to.eql([]));",
              "console.log(j.status, j.meta.reason, j.meta.cache, (j.results||[]).map(r => r.id + \":\" + r.score).join(\", \"));",
              "(j.results||[]).forEach(r => pm.test(\"カテゴリ一致 \" + r.id, () => pm.expect(r.category).to.eql(\"料金・契約\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"月額料金はいくらですか\",\n  \"category\": \"料金・契約\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/faq/search",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "faq",
            "search"
          ]
        }
      }
    },
